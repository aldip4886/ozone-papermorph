  "cues": [
   [
    0.106,
    "The Convention did something else that mattered."
   ],
   [
    2.633,
    "It accepted that action was needed before there was firm proof of harm."
   ],
   [
    6.835,
    "On one side, uncertain science."
   ],
   [
    9.455,
    "On the other, the risk of serious damage that cannot be undone."
   ],
   [
    13.723,
    "Act first, rather than wait."
   ],
   [
    15.851,
    "This is the precautionary principle, or approach."
   ],
   [
    19.149,
    "In nineteen ninety-two it was written into Principle fifteen of the Rio Declaration: a lack of full scientific certainty shall not be used as a reason to postpone cost-effective measures."
   ],
   [
    31.197,
    "The Vienna Convention is an early sign of that idea in international environmental law."
   ]
  ]
 },
