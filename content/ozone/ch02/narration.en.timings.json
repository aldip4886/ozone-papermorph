  "cues": [
   [
    0.12,
    "The story starts with science."
   ],
   [
    2.048,
    "In nineteen seventy-four, two chemists, Mario Molina and Sherwood Rowland, published a warning."
   ],
   [
    8.511,
    "C F Cs, they showed, drift up to the stratosphere, where sunlight breaks them apart and releases chlorine."
   ],
   [
    16.303,
    "Keep releasing C F Cs, they predicted, and stratospheric ozone will fall."
   ],
   [
    21.981,
    "Several countries began measuring the ozone layer, including over Antarctica."
   ],
   [
    27.194,
    "In nineteen ninety-five, Molina, Rowland and a third scientist, Paul Crutzen, shared the Nobel Prize in Chemistry for this work."
   ]
  ]
 },
