  "cues": [
   [
    0.146,
    "Finally, who runs the Convention?"
   ],
   [
    2.42,
    "At the top is the Conference of the Parties, or COP, which brings together every party."
   ],
   [
    8.098,
    "It meets every three years to review how the Convention is being carried out, and to decide policies and rules."
   ],
   [
    14.934,
    "Its Bureau, a President, three Vice-Presidents and a Rapporteur, works for the parties between meetings, reviewing the science."
   ],
   [
    23.364,
    "The Ozone Research Managers are government research managers and scientists."
   ],
   [
    28.338,
    "They meet six months before each COP, and send it their research recommendations."
   ],
   [
    33.843,
    "And the Ozone Secretariat, at U N E P headquarters in Nairobi, Kenya, organises the meetings and shares information, for both the Vienna Convention and the Montreal Protocol."
   ]
  ]
 },
