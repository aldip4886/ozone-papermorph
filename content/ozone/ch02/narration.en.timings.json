  "cues": [
   [
    0.106,
    "Adopted and entered into force are not the same thing."
   ],
   [
    3.683,
    "A treaty passes through four stages."
   ],
   [
    6.436,
    "First, negotiation, usually launched by a mandate from a body such as U N E P or the U N General Assembly."
   ],
   [
    14.362,
    "Second, adoption: the text is finalised."
   ],
   [
    17.819,
    "Third, ratification: each state formally agrees to be bound."
   ],
   [
    22.62,
    "Acceptance and approval work the same way."
   ],
   [
    25.718,
    "Fourth, entry into force, on the terms the treaty sets, often once enough countries have ratified."
   ],
   [
    32.62,
    "For the Vienna Convention, that was ninety days after the twentieth country ratified."
   ]
  ]
 },
