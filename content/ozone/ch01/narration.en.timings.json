  "cues": [
   [
    0.12,
    "So what is ozone?"
   ],
   [
    1.356,
    "Ordinary oxygen, the kind we breathe, is two oxygen atoms bonded together: O two."
   ],
   [
    7.899,
    "High in the stratosphere, ultraviolet light from the Sun is strong enough to split that pair into two single atoms."
   ],
   [
    15.359,
    "A single atom soon joins another oxygen molecule, and makes a molecule of three oxygen atoms."
   ],
   [
    21.769,
    "That is ozone, O three."
   ],
   [
    23.817,
    "Sunlight keeps making it, all the time."
   ]
  ]
 },
