  "cues": [
   [
    0.106,
    "Let's start with the sky above us."
   ],
   [
    2.221,
    "The lowest part of the atmosphere is the troposphere."
   ],
   [
    5.439,
    "It's where we live and where weather happens, and it reaches about ten to fifteen kilometres up."
   ],
   [
    11.263,
    "Above it is the stratosphere, which climbs to about fifty kilometres."
   ],
   [
    15.678,
    "Most of the stratosphere's ozone sits in one band, between about fifteen and thirty-five kilometres."
   ],
   [
    22.5,
    "That band is what we call the ozone layer."
   ],
   [
    25.133,
    "Around ninety percent of all ozone is up here in the stratosphere."
   ],
   [
    29.402,
    "The other ten percent is down in the troposphere, close to us."
   ]
  ]
 },
