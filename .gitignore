# private source material (Papermorph keeps it out of version control)
*.pdf
books/*/pages/
books/*/source.md
# upstream engine checkout (root only; Papermorph/engine/ is vendored)
/engine/
.claude/*
# ...except the project's own PDRI skills, shared through the repo
!.claude/skills/
.claude/skills/*
!.claude/skills/pdri-build-chapter/
!.claude/skills/pdri-voiceover/
!.claude/skills/pdri-presentasi/
# working leftovers
_to_delete/
__pycache__/
# vendored Papermorph (engine + skill): its demo books and upstream tooling stay out
Papermorph/site/
Papermorph/.github/
Papermorph/.opencode/
